    "cloud.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional and off by default. No Noctis account or proprietary server is required. Synchronization runs while the app is open and unlocked. Local data is always preserved when switching it off."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultative et désactivée par défaut. Aucun compte Noctis ni serveur propriétaire n’est requis. La synchronisation fonctionne lorsque l’application est ouverte et déverrouillée. La désactivation conserve toujours les données locales."
          }
        }
      }
    },
    "cloud.erase.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete the Noctis cloud copy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement la copie Noctis dans iCloud ?"
          }
        }
      }
    },
    "identity.import.contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import my contact card"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer ma fiche contact"
          }
        }
      }
    },
    "security.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native device authentication protects access and app previews. Biometric data and passcodes are never stored. iOS file protection protects the local store; on Mac, use FileVault. Face ID does not independently encrypt the SwiftData database."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification native protège l’accès et les aperçus. Aucune donnée biométrique ni aucun code n’est stocké. La protection des fichiers iOS protège le stockage local ; sur Mac, utilisez FileVault. Face ID ne chiffre pas lui-même la base SwiftData."
          }
        }
      }
    },
    "identity.authorization.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save to apply these authorizations. Only authorized fields are added to the local model context. After saving, disabling personalization keeps your profile but excludes it from future response contexts; it does not erase past messages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez pour appliquer ces autorisations. Seuls les champs autorisés sont ajoutés au contexte du modèle local. Après enregistrement, désactiver la personnalisation conserve le profil et l’exclut des prochains contextes ; cela n’efface pas les anciens messages."
          }
        }
      }
    },
    "identity.language": {
