          "stringUnit": {
            "state": "translated",
            "value": "Select only the names to copy. Phone numbers, email addresses, postal addresses and birthdays are never imported. Review and save the profile afterwards."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez uniquement les noms à copier. Les numéros, emails, adresses et anniversaires ne sont jamais importés. Vérifiez puis enregistrez le profil."
          }
        }
      }
    },
