          "stringUnit": {
            "state": "translated",
            "value": "Optional. This includes all saved profile fields and preserved conflict versions, even fields excluded from assistant personalization. Disabling this option stops profile exchanges; an existing cloud copy may remain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Inclut tous les champs enregistrés du profil et les versions conservées après conflit, même les champs exclus de la personnalisation. Désactiver cette option arrête les échanges du profil ; une copie déjà présente dans iCloud peut rester."
          }
        }
      }
    },
