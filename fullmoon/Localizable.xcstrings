    "cloud.erase.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization will stop. Only Noctis’s private synchronization zone will be deleted. Local conversations and your profile are preserved. Re-enabling synchronization can upload your local data again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation sera arrêtée. Seule la zone privée de synchronisation Noctis sera supprimée. Les conversations et le profil locaux sont conservés. Réactiver la synchronisation peut renvoyer vos données locales."
          }
        }
      }
    },
